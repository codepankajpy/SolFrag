{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ],
  "env": {
    "VITE_SOLANA_RPC_URL": "@solana_rpc_url",
    "VITE_WS_SERVER_URL": "@ws_server_url"
  }
}
