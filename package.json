    "@types/three": "^0.181.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.4"
  },
  "dependencies": {
    "@dimforge/rapier3d": "^0.19.3",
    "@dimforge/rapier3d-compat": "^0.19.3",
    "three": "^0.181.2",
    "@coral-xyz/anchor": "^0.29.0",
    "@solana/web3.js": "^1.95.3"
  }
}
