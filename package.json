{
  "name": "fps-game",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "copy-idl": "mkdir -p public/idl && cp onchain/target/idl/fps_game.json public/idl/fps_game.json",
